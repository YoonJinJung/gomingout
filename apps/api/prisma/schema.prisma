// 고밍아웃 DB 스키마.
// 모델 정의는 M1부터 마일스톤 순서대로 추가한다(SCHEMA.md 참조).
// 스키마 변경은 반드시 Prisma migration으로만 한다(CLAUDE.md 작업 방식).
//
// Prisma 7부터 연결 URL은 이 파일이 아니라 prisma.config.ts에 둔다.
// 런타임 연결은 PrismaClient에 driver adapter로 주입한다(src/db/prisma.ts).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}
