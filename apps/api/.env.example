# ─────────────────────────────────────────────────────────────
# apps/api 환경변수
#
# 이 파일을 복사해서 apps/api/.env 를 만든다:  cp apps/api/.env.example apps/api/.env
#
# ⚠️ 이 저장소는 public이다. .env 는 .gitignore로 제외되어 있으며,
#    이 파일(.env.example)에는 실제 시크릿을 절대 넣지 않는다.
#    아래 값들은 로컬 Docker 전용 더미값이다.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=4000

# 로컬 Docker Postgres (docker-compose.yml과 일치해야 한다)
DATABASE_URL=postgresql://gomingout:gomingout_local@localhost:5432/gomingout?schema=public
# 마이그레이션용 직접 연결 (T2). 로컬에서는 DATABASE_URL과 같은 값이면 된다.
DIRECT_URL=postgresql://gomingout:gomingout_local@localhost:5432/gomingout?schema=public

# 쿠키·CORS 대상 웹 오리진
WEB_ORIGIN=http://localhost:3000

# 이메일 발송
#   mock   : 콘솔에 인증 코드 출력 (로컬 기본 — 가장 빠름)
#   smtp   : Docker Mailpit 사용, http://localhost:8025 에서 확인
#   resend : 배포(M8)
EMAIL_PROVIDER=mock
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=고밍아웃 <no-reply@gomingout.local>

# rate limit 구현: memory(로컬) | upstash(배포 M8)
RATE_LIMIT_PROVIDER=memory

# 신고 누적 자동 블라인드 임계값 (PRD 8장)
REPORT_BLIND_THRESHOLD=5
